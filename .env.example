# Do not commit actual API credentials
TMDB_API_KEY=
WEB_SEARCH_API_KEY=
OPENAI_API_KEY=

# Stage 1 self-authored fixtures (no live provider)
LOCAL_DEMO_ENABLED=true
TMDB_ENABLED=false
# Bearer read access token (not the v3 API key); optional adapter stays disabled by default
TMDB_READ_ACCESS_TOKEN=

# Explicit opt-in checked real-series local collection; no live provider calls
SEARCH_COLLECTION=demo
CURATED_DATABASE=data/curated.sqlite
